#!/usr/bin/env bash
# astrocipher encode "text" | astrocipher decode pic.jpg
# Runs cli.py with claude_trusted/.venv when this folder lives there, otherwise with python3.
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do  # follow symlinks (e.g. .venv/bin/astrocipher) back to this folder
  DIR="$(cd "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  [[ "$SRC" != /* ]] && SRC="$DIR/$SRC"
done
DIR="$(cd "$(dirname "$SRC")" && pwd)"
PY="$DIR/../.venv/bin/python"
[ -x "$PY" ] || PY="python3"
exec "$PY" "$DIR/cli.py" "$@"
